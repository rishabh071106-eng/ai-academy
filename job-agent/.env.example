# AI provider key. config.json "provider" picks which one is used ("gemini" or "anthropic").
# Google Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude API key (https://console.anthropic.com), only needed with provider "anthropic".
ANTHROPIC_API_KEY=

# Chrome DevTools endpoint of the Chrome window where LinkedIn + Naukri are logged in.
# `npm run chrome` starts Chrome with this port using a dedicated profile.
CHROME_CDP_URL=http://127.0.0.1:9222

# Dashboard port
DASHBOARD_PORT=4321

# Password the agent uses to sign in to / create accounts on company career sites
# (Workday, iCIMS, …) with her email. Pick a strong one used only for job sites.
ATS_PASSWORD=
